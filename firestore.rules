rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función: usuario autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Identificador de usuario por email
    function getUserEmail() {
      return request.auth.token.email;
    }

    // Función: el documento pertenece al usuario que lo solicita
    function isOwner(emailField) {
      return isAuthenticated() && getUserEmail() == emailField;
    }

    // ──────────────────────────────────────────────
    // 0. EMPRESAS (companies)
    // ──────────────────────────────────────────────
    match /companies/{companyId} {
      // Cualquiera puede leer (para cargar datos en el portal del cliente)
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.adminEmail == getUserEmail();
      // Solo el admin de la empresa puede modificarla
      allow update, delete: if isAuthenticated() && resource.data.adminEmail == getUserEmail();
    }

    // ──────────────────────────────────────────────
    // 0.1 INVITACIONES (invites)
    // ──────────────────────────────────────────────
    match /invites/{code} {
      // Lectura pública: se necesita para validar el código antes de login
      allow read: if true;
      // Cualquier autenticado puede crear (el admin lo hace desde su panel)
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ──────────────────────────────────────────────
    // 0.5 TICKETS DE SOPORTE (tickets)
    // ──────────────────────────────────────────────
    match /tickets/{ticketId} {
      // Cualquier cliente (incluso sin iniciar sesión) puede crear un ticket
      allow create: if true;
      
      // Lectura y modificación:
      // Para una app de MVP, permitimos a usuarios logueados del equipo modificar tickets.
      // La lectura es pública para que el cliente acceda a su portal de estado usando el ID.
      allow read: if true;
      allow update, delete: if isAuthenticated();
    }

    // ──────────────────────────────────────────────
    // 1. VISITAS (visits)
    // ──────────────────────────────────────────────
    match /visits/{visitId} {
      allow read: if true;
      
      // Admin o Técnico pueden crear/actualizar
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
      
      // ──────────────────────────────────────────────
      // 1.1 ACTIVIDADES DE LA VISITA (subcolección)
      // ──────────────────────────────────────────────
      match /activities/{activityId} {
        allow read: if true;
        allow create, update, delete: if isAuthenticated();
      }
    }

    // ──────────────────────────────────────────────
    // 2. CLIENTES (clients)
    // ──────────────────────────────────────────────
    match /clients/{clientId} {
      allow read, create, update, delete: if isAuthenticated();
    }

    // ──────────────────────────────────────────────
    // 3. PERFIL PROFESIONAL (profiles)
    // ──────────────────────────────────────────────
    match /profiles/{emailId} {
      allow read: if true;
      allow write: if isOwner(emailId);
    }
    
  }
}

